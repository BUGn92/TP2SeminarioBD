# =====================================================================
# Configuración de Conexión a Microsoft SQL Server (TP2 - Equipo 6)
# =====================================================================
# Copia este archivo como .env y completa con tus credenciales locales.
# NUNCA subas el archivo .env a GitHub ni guardes contraseñas en código.

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=sakila_es
DB_USER=sa
DB_PASSWORD=TuPasswordSegura123!

# Controlador ODBC (ODBC Driver 18 for SQL Server u ODBC Driver 17 for SQL Server)
DB_DRIVER=ODBC Driver 18 for SQL Server

# Autenticación integrada de Windows (yes/no). Si es yes, DB_USER y DB_PASSWORD se ignoran.
DB_TRUSTED_CONNECTION=no

# Confianza en el certificado SSL del servidor (necesario en Driver 18 para entornos dev)
DB_TRUST_SERVER_CERTIFICATE=yes
