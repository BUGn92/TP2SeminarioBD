-- 3. Se utiliza LEFT JOIN para conservar el 100% del catálogo (incluidas
--    las 42 películas sin copias en inventario) y COUNT(DISTINCT ...) en
--    alquileres para evitar multiplicación ante múltiples pagos por alquiler.
-- =====================================================================

SELECT
    f.[id_pelicula]                     AS film_id,
    f.[titulo]                  AS title,
    f.[tarifa_alquiler]                   AS rental_rate,
    f.[costo_reemplazo]                   AS replacement_cost,
    f.[duracion_alquiler]               AS rental_duration,
    f.[clasificacion]                 AS rating,
    COUNT(DISTINCT i.[id_inventario])      AS inventory_count,
    COUNT(DISTINCT r.[id_alquiler])     AS rental_count,
    ISNULL(SUM(p.[monto]), 0.0) AS total_revenue
FROM [dbo].[pelicula] f
LEFT JOIN [dbo].[inventario] i
    ON f.[id_pelicula] = i.[id_pelicula]
LEFT JOIN [dbo].[alquiler] r
    ON i.[id_inventario] = r.[id_inventario]
LEFT JOIN [dbo].[pago] p
    ON r.[id_alquiler] = p.[id_alquiler]
WHERE f.[tarifa_alquiler] BETWEEN ? AND ?
  AND (? IS NULL OR f.[clasificacion] = ?)
GROUP BY
    f.[id_pelicula],
    f.[titulo],
    f.[tarifa_alquiler],
    f.[costo_reemplazo],
    f.[duracion_alquiler],
    f.[clasificacion]
ORDER BY
    f.[id_pelicula];
]
